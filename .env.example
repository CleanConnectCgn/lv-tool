# Postgres (Block 2). Auf Railway automatisch gesetzt, wenn ein Postgres-
# Service im Projekt existiert und per Referenzvariable verknüpft ist
# (railway variables --set 'DATABASE_URL=${{Postgres.DATABASE_URL}}').
DATABASE_URL=

# KI-Checkup, LV-aus-Bild (Gemini Vision)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# sevDesk-Integration - optional, sonst manuell im Formular eintragbar
SEVDESK_TOKEN=

# Google OAuth-Client (Google Cloud Console). Wird für ZWEI getrennte Zwecke
# genutzt, beide brauchen ihre eigene Redirect-URI im selben OAuth-Client:
#   - Anmeldung (Block 3):        <domain>/api/auth/google/callback
#   - Firmenkalender-Verbindung:  <domain>/api/calendar/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Block 3: Google OAuth ist der einzige Anmeldeweg, kein optionales
# Basic-Auth mehr. Ohne diese drei Variablen startet der Server, aber jede
# Anmeldung schlägt fehl (klare Fehlermeldung statt stillem Sicherheitsloch).
#
# Kommagetrennte Liste erlaubter Google-Konten. Wer hier nicht steht, sieht
# nach dem Google-Login eine klare Ablehnungs-Meldung, keinen Fehlercode.
ALLOWED_EMAILS=
# Signiert das Session-Cookie (HMAC). Erzeugen mit: openssl rand -base64 32
SESSION_SECRET=
# Verschlüsselt die gespeicherten Google-Tokens (AES-256-GCM), 32 Byte
# base64. Erzeugen mit: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Tägliche E-Mail-Zusammenfassung (lange offene Aufträge, Termine der
# nächsten 24h). Gmail SMTP mit App-Passwort (nicht das normale
# Account-Passwort - unter myaccount.google.com/apppasswords erzeugen,
# erfordert 2FA auf dem Google-Konto). Ohne diese Variablen: kein E-Mail-Versand.
SMTP_USER=
SMTP_APP_PASSWORD=
# Optional: Empfänger, falls abweichend von SMTP_USER
NOTIFY_EMAIL=

# Pfad für persistente Daten (Dokumente, CRM). Auf Railway: Volume-Mountpunkt.
DATA_DIR=

# Nur relevant, falls im vertragsgenerator APP_USERNAME/APP_PASSWORD +
# CRM_SYNC_TOKEN gesetzt sind - muss dann mit dessen CRM_SYNC_TOKEN
# übereinstimmen, damit die Verträge-Anzeige im Kundenprofil weiter
# funktioniert. Wird beim Frontend-Build eingebettet (VITE_-Präfix nötig).
VITE_CRM_SYNC_TOKEN=

PORT=3001
